{
  "name": "react-aria-live",
  "version": "3.0.0",
  "description": "Broadcast aria-live messages to VoiceOver, NVDA, JAWS, and TalkBack from anywhere in your React app",
  "type": "module",
  "main": "dist/react-aria-live.cjs",
  "module": "dist/react-aria-live.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/react-aria-live.js",
      "require": "./dist/react-aria-live.cjs"
    }
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "prop-types": "15.8.1"
  },
  "peerDependencies": {
    "react": ">=16.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "30.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "7.3.1",
    "vitest": "5.0.3"
  },
  "author": "Almero Steyn, Diego Javier Mena Amado",
  "license": "MIT",
  "repository": "https://github.com/ingelectronicadj/react-aria-live",
  "keywords": [
    "react",
    "react-component",
    "accessibility",
    "a11y",
    "aria-live",
    "voiceover",
    "nvda",
    "screen-reader",
    "wcag"
  ]
}
